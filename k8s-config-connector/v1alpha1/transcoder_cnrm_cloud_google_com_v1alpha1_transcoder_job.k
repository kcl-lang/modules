schema TranscoderCnrmCloudGoogleComV1alpha1TranscoderJobSpecConfigSpriteSheetsItems0:
    r"""
    transcoder cnrm cloud google com v1alpha1 transcoder job spec config sprite sheets items0

    Attributes
    ----------
    columnCount : int, default is Undefined, optional
        The maximum number of sprites per row in a sprite sheet. The default is 0, which indicates no maximum limit.
    endTimeOffset : str, default is Undefined, optional
        End time in seconds, relative to the output file timeline. When `end_time_offset` is not specified, the sprites are generated until the end of the output file.
    filePrefix : str, default is Undefined, optional
        Required. File name prefix for the generated sprite sheets.

         Each sprite sheet has an incremental 10-digit zero-padded suffix starting
         from 0 before the extension, such as `sprite_sheet0000000123.jpeg`.
    format : str, default is Undefined, optional
        Format type. The default is `jpeg`.

         Supported formats:

         - `jpeg`
    interval : str, default is Undefined, optional
        Starting from `0s`, create sprites at regular intervals. Specify the interval value in seconds.
    quality : int, default is Undefined, optional
        The quality of the generated sprite sheet. Enter a value between 1 and 100, where 1 is the lowest quality and 100 is the highest quality. The default is 100. A high quality value corresponds to a low image data compression ratio.
    rowCount : int, default is Undefined, optional
        The maximum number of rows per sprite sheet. When the sprite sheet is full, a new sprite sheet is created. The default is 0, which indicates no maximum limit.
    spriteHeightPixels : int, default is Undefined, optional
        Required. The height of sprite in pixels. Must be an even integer. To
         preserve the source aspect ratio, set the
         [SpriteSheet.sprite_height_pixels][google.cloud.video.transcoder.v1.SpriteSheet.sprite_height_pixels]
         field or the
         [SpriteSheet.sprite_width_pixels][google.cloud.video.transcoder.v1.SpriteSheet.sprite_width_pixels]
         field, but not both (the API will automatically calculate the missing
         field).

         For portrait videos that contain horizontal ASR and rotation metadata,
         provide the height, in pixels, per the horizontal ASR. The API calculates
         the width per the horizontal ASR. The API detects any rotation metadata
         and swaps the requested height and width for the output.
    spriteWidthPixels : int, default is Undefined, optional
        Required. The width of sprite in pixels. Must be an even integer. To
         preserve the source aspect ratio, set the
         [SpriteSheet.sprite_width_pixels][google.cloud.video.transcoder.v1.SpriteSheet.sprite_width_pixels]
         field or the
         [SpriteSheet.sprite_height_pixels][google.cloud.video.transcoder.v1.SpriteSheet.sprite_height_pixels]
         field, but not both (the API will automatically calculate the missing
         field).

         For portrait videos that contain horizontal ASR and rotation metadata,
         provide the width, in pixels, per the horizontal ASR. The API calculates
         the height per the horizontal ASR. The API detects any rotation metadata
         and swaps the requested height and width for the output.
    startTimeOffset : str, default is Undefined, optional
        Start time in seconds, relative to the output file timeline. Determines the first sprite to pick. The default is `0s`.
    totalCount : int, default is Undefined, optional
        Total number of sprites. Create the specified number of sprites distributed evenly across the timeline of the output media. The default is 100.
    """


    columnCount?: int

    endTimeOffset?: str

    filePrefix?: str

    format?: str

    interval?: str

    quality?: int

    rowCount?: int

    spriteHeightPixels?: int

    spriteWidthPixels?: int

    startTimeOffset?: str

    totalCount?: int


