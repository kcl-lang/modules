schema TranscoderCnrmCloudGoogleComV1alpha1TranscoderJobSpecConfigInputsItems0PreprocessingConfigAudio:
    r"""
    Audio preprocessing configuration.

    Attributes
    ----------
    highBoost : bool, default is Undefined, optional
        Enable boosting high frequency components. The default is `false`.

         **Note:** This field is not supported.
    lowBoost : bool, default is Undefined, optional
        Enable boosting low frequency components. The default is `false`.

         **Note:** This field is not supported.
    lufs : float, default is Undefined, optional
        Specify audio loudness normalization in loudness units relative to full
         scale (LUFS). Enter a value between -24 and 0 (the default), where:

         *   -24 is the Advanced Television Systems Committee (ATSC A/85) standard
         *   -23 is the EU R128 broadcast standard
         *   -19 is the prior standard for online mono audio
         *   -18 is the ReplayGain standard
         *   -16 is the prior standard for stereo audio
         *   -14 is the new online audio standard recommended by Spotify, as well
             as Amazon Echo
         *   0 disables normalization
    """


