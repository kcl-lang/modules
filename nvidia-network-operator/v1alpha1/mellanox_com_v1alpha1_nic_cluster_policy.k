schema MellanoxComV1alpha1NicClusterPolicySpecNicConfigurationOperatorNicFirmwareStorage:
    r"""
    NicFirmwareStorage contains configuration for the NIC firmware storage. If not provided, the NIC firmware storage will not be configured.

    Attributes
    ----------
    availableStorageSize : str, default is "1Gi", optional
        AvailableStorageSize is storage size for the NIC Configuration Operator to request. Only applies if nicFirmwareStorage.create == true. Default value: 1Gi
    create : bool, default is True, optional
        Create specifies whether to create a new PVC or use an existing one
        If create == false, the existing PVC with the name specified in pvcName should be located in the same namespace as the operator
    pvcName : str, default is "nic-fw-storage-pvc", optional
        PVCName is the name of the PVC to mount as NIC Firmware storage. Default value: "nic-fw-storage-pvc"
    storageClassName : str, default is Undefined, optional
        StorageClassName is the name of a storage class to be used to store NIC FW binaries during NIC FW upgrade.
        If not provided, the cluster-default storage class will be used
    """


    availableStorageSize?: str = "1Gi"

    create?: bool = True

    pvcName?: str = "nic-fw-storage-pvc"

    storageClassName?: str


    check:
        _regex_match(str(availableStorageSize), r"^(\d+)(Ei|Pi|Ti|Gi|Mi|Ki)$") if availableStorageSize
        len(pvcName) <= 63 if pvcName not in [None, Undefined]
        len(pvcName) >= 1 if pvcName not in [None, Undefined]
        _regex_match(str(pvcName), r"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$") if pvcName
        len(storageClassName) <= 63 if storageClassName not in [None, Undefined]
        len(storageClassName) >= 1 if storageClassName not in [None, Undefined]
        _regex_match(str(storageClassName), r"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$") if storageClassName


