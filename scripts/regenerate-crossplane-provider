#!/usr/bin/env bash

# This simple script generates kcl schemas from crossplane provider packages
# it downloads xpkg package from xpkg.crossplane.io, find all the crds there
# and groups them by apiGroup, also separates clustered and namespaced resources
# which is detected by .m.crossplane.io vs .crossplane.io suffix
# it needs kcl, crossplane cli and mikefarah yq

set -e
shopt -s extglob

if (( $# < 2 || $# > 3 )); then
    echo "$0 provider version [output-dir]"
    exit 1
fi

provider="${1}"
version="${2}"
provider_package="xpkg.crossplane.io/crossplane-contrib/provider-$provider:$version"
namespaced_apis="${provider}.m.crossplane.io"
cluster_apis="${provider}.crossplane.io"

for tool in gh kcl; do
    if ! type $tool &>/dev/null; then
       echo "missing $tool"
       echo "please install gh (GitHub CLI) kcl"
       exit 1
    fi
done

cd "$(git rev-parse --show-toplevel)"

work_dir="$(mktemp -d)"
# trap 'rm -rf "$work_dir"' EXIT
crd_dir="${work_dir}/crds"

root="$(git rev-parse --show-toplevel)"
kcl_dir="${3:-crossplane_provider_$provider}"
# Ensure absolute path
[[ "$kcl_dir" = /* ]] || kcl_dir="$root/$kcl_dir"

if [[ -d "$kcl_dir" ]] ; then
    rm -r "${kcl_dir}"
fi

mkdir -p "${crd_dir}"

# Download CRDs from GitHub (package/crds directory)
repo="crossplane-contrib/provider-$provider"
crd_gh_path="package/crds"
echo "Downloading CRDs from https://github.com/$repo at $version ..."
while IFS= read -r filename; do
    gh api "/repos/$repo/contents/$crd_gh_path/$filename?ref=$version" --jq '.content' \
        | base64 -d > "$crd_dir/$filename"
done < <(gh api "/repos/$repo/contents/$crd_gh_path?ref=$version" --jq '.[].name')

# GitHub uses group_resource.yaml naming; rename to resource.group.yaml for find/sed compatibility
for f in "$crd_dir"/*.yaml; do
    base=$(basename "$f")
    group="${base%%_*}"
    resource="${base#*_}"
    mv "$f" "${crd_dir}/${resource%.yaml}.${group}.yaml"
done

mkdir -p "${kcl_dir}"
cd "${kcl_dir}"
kcl mod init --version "${version#v}"
kcl mod add k8s
mkdir namespaced cluster

mapfile -t namespaced_groups < <(find  "$crd_dir" -name "*${namespaced_apis}.yaml" -exec basename {} \; | sed -E "s/^[^.]*\.//; s/\.yaml$//; s/\.?$namespaced_apis//" | sort | uniq)
mapfile -t cluster_groups < <(find  "$crd_dir" -name "*${cluster_apis}.yaml" -exec basename {} \; | sed -E "s/^[^.]*\.//; s/\.yaml$//; s/\.?$cluster_apis//" | sort | uniq)

for group in "${namespaced_groups[@]}" ; do (
    parent_group_dir="$(dirname "$(tr '.' '/'<<<"$group")")"
    cd "$kcl_dir/namespaced"
    mkdir -p "$parent_group_dir"
    cd "$parent_group_dir"
    project="${group%%.*}"
    [[ -n "$group" ]] && group+=.
    if [[ -z "$group" ]]; then
        cd ..
        project=namespaced
    fi

    kcl import -m crd -p "$project" "${crd_dir}/"+([a-z0-9])".${group}${namespaced_apis}.yaml"
    ) 
done

for group in "${cluster_groups[@]}" ; do (
    parent_group_dir="$(dirname "$(tr '.' '/'<<<"$group")")"
    cd "$kcl_dir/cluster"
    mkdir -p "$parent_group_dir"
    cd "$parent_group_dir"
    project="${group%%.*}"
    [[ -n "$group" ]] && group+=.
    if [[ -z "$group" ]]; then
        cd ..
        project=cluster
    fi

    kcl import -m crd -p "$project" "${crd_dir}/"+([a-z0-9])".${group}${cluster_apis}.yaml"
    ) 
done

# delete autogenerated mod files and duplicite k8s module
find . '(' -path './*/**k8s**' -o -path './*/**kcl.mod' ')' -delete

# Fix KCL acronym naming: kcl import splits short acronyms letter-by-letter when followed by lowercase
# e.g. http.m.crossplane.io -> h_t_t_pm_crossplane_io instead of httpm_crossplane_io
# Only file names are affected; schema names inside are valid KCL and stay unchanged.
upper_provider="${provider^^}"
broken_prefix="$(echo "$upper_provider" | sed -E 's/(.)/\1_/g; s/_$//' | tr 'A-Z' 'a-z')"
if [[ "$broken_prefix" != "$provider" ]]; then
    while IFS= read -r f; do
        dir=$(dirname "$f")
        base=$(basename "$f")
        newbase="${base//$broken_prefix/$provider}"
        [[ "$base" != "$newbase" ]] && mv "$f" "$dir/$newbase"
    done < <(find . -name "${broken_prefix}*.k")
fi
