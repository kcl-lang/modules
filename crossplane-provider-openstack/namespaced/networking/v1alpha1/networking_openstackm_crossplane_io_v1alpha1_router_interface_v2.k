schema NetworkingOpenstackmCrossplaneIoV1alpha1RouterInterfaceV2StatusAtProvider:
    r"""
    networking openstackm crossplane io v1alpha1 router interface v2 status at provider

    Attributes
    ----------
    forceDestroy : bool, default is Undefined, optional
        A boolean indicating whether the routes from the
        corresponding router ID should be deleted so that the router interface can
        be destroyed without any errors. The default value is false.
    id : str, default is Undefined, optional
        id
    portId : str, default is Undefined, optional
        ID of the port this interface connects to. Changing
        this creates a new router interface.
    region : str, default is Undefined, optional
        The region in which to obtain the V2 networking client.
        A networking client is needed to create a router. If omitted, the
        region argument of the provider is used. Changing this creates a new
        router interface.
    routerId : str, default is Undefined, optional
        ID of the router this interface belongs to. Changing
        this creates a new router interface.
    subnetId : str, default is Undefined, optional
        ID of the subnet this interface connects to. Changing
        this creates a new router interface.
    """


    forceDestroy?: bool

    id?: str

    portId?: str

    region?: str

    routerId?: str

    subnetId?: str


