schema MemorystoreCnrmCloudGoogleComV1beta1MemorystoreInstanceStatusObservedStateEndpointsItems0ConnectionsItems0PscAutoConnection:
    r"""
    Detailed information of a PSC connection that is created through service connectivity automation.

    Attributes
    ----------
    connectionType : str, default is Undefined, optional
        Output only. Type of the PSC connection.
    forwardingRule : str, default is Undefined, optional
        Output only. The URI of the consumer side forwarding rule. Format: projects/{project}/regions/{region}/forwardingRules/{forwarding_rule}
    ipAddress : str, default is Undefined, optional
        Output only. The IP allocated on the consumer network for the PSC forwarding rule.
    port : int, default is Undefined, optional
        Optional. Output only. port will only be set for Primary/Reader or Discovery endpoint.
    pscConnectionID : str, default is Undefined, optional
        Output only. The PSC connection id of the forwarding rule connected to the service attachment.
    pscConnectionStatus : str, default is Undefined, optional
        Output only. The status of the PSC connection: whether a connection exists and ACTIVE or it no longer exists. Please note that this value is updated periodically. Please use Private Service Connect APIs for the latest status.
    serviceAttachment : str, default is Undefined, optional
        Output only. The service attachment which is the target of the PSC connection, in the form of projects/{project-id}/regions/{region}/serviceAttachments/{service-attachment-id}.
    """


    connectionType?: str

    forwardingRule?: str

    ipAddress?: str

    port?: int

    pscConnectionID?: str

    pscConnectionStatus?: str

    serviceAttachment?: str


